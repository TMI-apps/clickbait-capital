{
  "font": {
    "$type": "fontFamily",
    "$description": "Font stacks. CSS: --<name>.",
    "body-font": {
      "$value": ["Inter", "sans-serif"]
    },
    "heading-font": {
      "$value": ["Space Grotesk", "sans-serif"],
      "$description": "Techy grotesk for headings (neon feed look)."
    },
    "mono-font": {
      "$value": [
        "ui-monospace",
        "SFMono-Regular",
        "Menlo",
        "Consolas",
        "Liberation Mono",
        "monospace"
      ]
    }
  },
  "shape": {
    "$type": "dimension",
    "$description": "Corner radii. card-radius / input-radius are optional overrides derived in src/index.css (@theme inline).",
    "radius": {
      "$value": {
        "value": 0.75,
        "unit": "rem"
      },
      "$description": "Base radius; Tailwind rounded-sm/md/lg/xl derive from it."
    },
    "button-radius": {
      "$value": "{shape.radius}",
      "$description": "Buttons follow the base radius."
    }
  },
  "spacing": {
    "$type": "dimension",
    "spacing": {
      "$value": {
        "value": 0.25,
        "unit": "rem"
      },
      "$description": "Tailwind spacing unit (density)."
    }
  },
  "layout": {
    "$type": "dimension",
    "app-toolbar-height": {
      "$value": {
        "value": 64,
        "unit": "px"
      }
    }
  },
  "motion": {
    "$description": "Durations and easing. Reduced motion: reduced-motion.tokens.json.",
    "duration-fast": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "duration-normal": {
      "$type": "duration",
      "$value": {
        "value": 200,
        "unit": "ms"
      }
    },
    "duration-slow": {
      "$type": "duration",
      "$value": {
        "value": 600,
        "unit": "ms"
      }
    },
    "ease-standard": {
      "$type": "cubicBezier",
      "$value": [0.4, 0, 0.2, 1]
    },
    "duration-card-draw": {
      "$type": "duration",
      "$value": {
        "value": 420,
        "unit": "ms"
      },
      "$description": "A card entering the hand."
    },
    "duration-card-play": {
      "$type": "duration",
      "$value": {
        "value": 320,
        "unit": "ms"
      },
      "$description": "A card being played into the feed; also the select lift."
    },
    "ease-card": {
      "$type": "cubicBezier",
      "$value": [0.34, 1.56, 0.64, 1],
      "$description": "Springy overshoot for card draw/play (game juice)."
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Shadows used by the elevation-* utilities. Brand elevations vary by mode (light/dark files).",
    "elevation-sm": {
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.1,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 3,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0, 0, 0],
            "alpha": 0.1,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 2,
            "unit": "px"
          },
          "spread": {
            "value": -1,
            "unit": "px"
          }
        }
      ]
    },
