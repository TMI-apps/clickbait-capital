  "game-card": {
    "$description": "Game card frame (GameCard kit component).",
    "game-card-radius": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "game-card-border-width": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "px"
      }
    },
    "game-card-image-aspect": {
      "$type": "number",
      "$value": 1.3333,
      "$description": "Image area width / height (4:3). Images crop with object-fit: cover around their focal point."
    }
  }
