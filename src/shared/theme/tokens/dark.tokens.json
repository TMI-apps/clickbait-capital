{
  "color": {
    "$type": "color",
    "$description": "Semantic colors (dark). CSS: --<name>.",
    "background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.051, 0.0392, 0.0902],
        "hex": "#0d0a17"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9451, 0.9255, 1],
        "hex": "#f1ecff"
      }
    },
    "card": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0941, 0.0706, 0.1569],
        "hex": "#181228"
      }
    },
    "card-foreground": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9451, 0.9255, 1],
        "hex": "#f1ecff"
      }
    },
    "popover": {
