{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__supabase__*",
      "mcp__github__*"
    ],
    "ask": [],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars*)",
      "Read(!**/.env.example)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/ensure-deps-installed.cjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/deny-git-write-on-main.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/lint-edited-file.cjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/type-check-on-stop.cjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "plate-harness": {
      "source": {
        "source": "github",
        "repo": "value-machine/bronze-plate-harness"
      }
    }
  },
  "enabledPlugins": {
    "cursor-migration@plate-harness": true
  },
  "outputStyle": "default",
  "plansDirectory": "./documentation/jobs"
}
